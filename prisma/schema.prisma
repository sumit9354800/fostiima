generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id            String    @id
  name          String    @db.Text
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?   @db.Text
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  role          String?   @db.Text
  banned        Boolean?  @default(false)
  banReason     String?   @db.Text
  banExpires    DateTime?
  accounts      Account[]
  sessions      Session[]

  @@map("user")
}

model Session {
  id             String   @id
  expiresAt      DateTime
  token          String   @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  ipAddress      String?  @db.Text
  userAgent      String?  @db.Text
  userId         String
  impersonatedBy String?  @db.Text
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String    @db.Text
  providerId            String    @db.Text
  userId                String
  accessToken           String?   @db.Text
  refreshToken          String?   @db.Text
  idToken               String?   @db.Text
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?   @db.Text
  password              String?   @db.Text
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Faculty {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  image         String   @db.Text
  qualification String   @db.Text
  experience    String
  domain        String   @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([name])
  @@map("faculty")
}

model BlogPost {
  id              String        @id @default(cuid())
  slug            String        @unique
  title           String
  excerpt         String        @db.Text
  category        String
  coverImage      String        @db.Text
  coverImageAlt   String
  author          String
  publishedAt     DateTime?
  status          BlogStatus    @default(draft)
  metaTitle       String?       @db.Text
  metaDescription String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  blocks          BlogBlock[]
  blogKeywords    BlogKeyword[]

  @@index([status])
  @@index([category])
  @@index([publishedAt])
  @@map("blog_post")
}

model BlogBlock {
  id        String   @id @default(cuid())
  postId    String
  type      String
  position  Int
  content   String?  @db.LongText
  data      String?  @db.LongText
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId, position])
  @@map("blog_block")
}

model BlogKeyword {
  id      String   @id @default(cuid())
  postId  String
  keyword String
  post    BlogPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@map("blog_keyword")
}

model HomeHero {
  id        String   @id @default(cuid())
  videoUrl  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("home_hero")
}

model HomeStat {
  id        String   @id @default(cuid())
  value     String
  label     String
  icon      String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("home_stat")
}

model HomeAbout {
  id           String               @id @default(cuid())
  eyebrow      String
  title        String
  description1 String               @db.Text
  description2 String?              @db.Text
  isActive     Boolean              @default(true)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  highlights   HomeAboutHighlight[]

  @@map("home_about")
}

model HomeAboutHighlight {
  id          String    @id @default(cuid())
  homeAboutId String
  title       String
  description String    @db.Text
  icon        String
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  homeAbout   HomeAbout @relation(fields: [homeAboutId], references: [id], onDelete: Cascade)

  @@index([homeAboutId])
  @@index([sortOrder])
  @@map("home_about_highlight")
}

model HomePlacementVideo {
  id        String   @id @default(cuid())
  youtubeId String
  title     String
  batch     String
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
  @@map("home_placement_video")
}

model HomeProgram {
  id        String            @id @default(cuid())
  title     String
  category  String
  duration  String
  imageUrl  String
  href      String
  sortOrder Int               @default(0)
  isActive  Boolean           @default(true)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  semesters ProgramSemester[]

  @@index([sortOrder])
  @@map("home_program")
}

model ProgramSemester {
  id        String      @id @default(cuid())
  programId String
  title     String
  sortOrder Int         @default(0)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  program   HomeProgram @relation(fields: [programId], references: [id])

  @@index([programId])
  @@map("program_semester")
}

enum BlogStatus {
  draft
  published
}

enum ContentStatus {
  draft
  published
}

model Faq {
  id        String   @id @default(cuid())
  question  String   @db.Text
  answer    String   @db.Text
  category  String   @default("General") @db.VarChar(100)
  sortOrder Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@map("faqs")
}

model AdmissionEnquiry {
  id         String   @id @default(cuid())
  fullName   String   @db.VarChar(150)
  mobile     String   @db.VarChar(20)
  email      String   @db.VarChar(254)
  state      String   @db.VarChar(100)
  city       String   @db.VarChar(150)
  course     String   @default("PGDM") @db.VarChar(100)
  remarks    String?  @db.Text
  consent    Boolean  @default(false)
  source     String   @default("FOSTIIMA Website") @db.VarChar(150)
  status     String   @default("NEW") @db.VarChar(30)
  emailSent  Boolean  @default(false)
  emailError String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([mobile])
  @@index([email])
  @@map("admission_enquiry")
}

model ContactEnquiry {
  id         String   @id @default(cuid())
  name       String   @db.VarChar(150)
  email      String   @db.VarChar(254)
  phone      String   @db.VarChar(30)
  subject    String   @db.VarChar(200)
  message    String   @db.Text
  status     String   @default("NEW") @db.VarChar(30)
  emailSent  Boolean  @default(false)
  emailError String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, createdAt])
  @@index([email])
  @@map("contact_enquiry")
}
